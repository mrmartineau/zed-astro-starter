---
import { Link } from '@mrmartineau/zui/astro'
import { navItems, routes, site } from '../site'

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<header class="masthead">
	<a class="masthead-brand" href={routes.home}>{site.name}</a>
	<nav aria-label="Main">
		<ul class="masthead-nav flex items-center gap-md">
			{
				navItems.map((item) => (
					<li>
						<Link
							class="masthead-link"
							href={item.href}
							aria-current={item.href === currentPath ? 'page' : undefined}
						>
							{item.label}
						</Link>
					</li>
				))
			}
		</ul>
	</nav>
</header>

<style>
	@layer components {
		.masthead {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: var(--space-sm);
			max-inline-size: var(--site-max-inline-size);
			margin-inline: auto;
			inline-size: 100%;
			padding: var(--space-sm) var(--space-sm-md);
			border-block-end: 1px var(--border-style) var(--color-border);
		}

		.masthead-brand {
			font-size: var(--step-1);
			font-weight: var(--font-weight-bold);
			color: var(--color-text);
			text-decoration: none;
		}

		.masthead-nav {
			list-style: none;
			padding: 0;
		}

		.masthead-link[aria-current='page'] {
			font-weight: var(--font-weight-bold);
		}
	}
</style>
