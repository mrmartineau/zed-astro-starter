---
import { Link, Prose } from '@mrmartineau/zui/astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { site } from '../site'
---

<BaseLayout title="Contact" description={`How to contact ${site.name}.`}>
	<Prose>
		<h1>Contact</h1>
		<p>The quickest way to reach us is by email:</p>
		<p><Link href={`mailto:${site.email}`}>{site.email}</Link></p>
		<p>Add other ways to get in touch here, such as social links or a booking page.</p>
	</Prose>
</BaseLayout>
