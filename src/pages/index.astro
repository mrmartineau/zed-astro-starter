---
import { Link, Prose } from '@mrmartineau/zui/astro'
import BaseLayout from '../layouts/BaseLayout.astro'
import { routes, site } from '../site'
---

<BaseLayout>
	<Prose>
		<h1>{site.name}</h1>
		<p>{site.description}</p>
		<p>
			Edit <code>src/site.ts</code> to set the site name, description and contact email. Add a page by
			adding a file to <code>src/pages/</code>.
		</p>
		<p><Link href={routes.about}>Read more about this site</Link></p>
	</Prose>
</BaseLayout>
